{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "citation-report.json as bin/cite-check.sh writes it",
  "type": "object",
  "required": ["expected_commit", "quote_cap_lines", "cards_dir", "territory", "citations", "cards", "totals"],
  "properties": {
    "expected_commit": { "type": "string", "minLength": 7, "default": "0000000" },
    "quote_cap_lines": { "type": "integer", "minimum": 1, "default": 5 },
    "cards_dir": { "type": "string", "minLength": 1, "default": "02_cards/output/cards" },
    "territory": { "type": "string", "minLength": 1, "default": "../_territory" },
    "citations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["card", "citation", "resolved", "reason"],
        "properties": {
          "card": { "type": "string", "minLength": 1, "default": "base-layout.md" },
          "citation": { "type": "string", "minLength": 1, "default": "src/layouts/Base.astro:2@0000000" },
          "resolved": { "type": "boolean", "default": true },
          "reason": { "type": "string", "default": "resolved" }
        }
      }
    },
    "cards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["card", "quoted_lines", "over_cap"],
        "properties": {
          "card": { "type": "string", "minLength": 1, "default": "base-layout.md" },
          "quoted_lines": { "type": "integer", "minimum": 0, "default": 0 },
          "over_cap": { "type": "boolean", "default": false }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["citations", "unresolved", "cards", "cards_over_cap"],
      "properties": {
        "citations": { "type": "integer", "minimum": 0, "default": 1 },
        "unresolved": { "type": "integer", "minimum": 0, "default": 0 },
        "cards": { "type": "integer", "minimum": 0, "default": 8 },
        "cards_over_cap": { "type": "integer", "minimum": 0, "default": 0 }
      }
    }
  }
}
