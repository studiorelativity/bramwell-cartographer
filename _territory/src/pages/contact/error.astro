---
import Base from "../../layouts/Base.astro";
---
<Base title="Message not sent" description="The message didn't send. The form is one link away.">
  <section class="nf-section">
    <div class="nf-content">
      <h1>Message not sent</h1>
      <p>
        That message didn't send. Nothing reached us, so it is worth sending again — the
        form is one link away and your details are still yours to re-enter.
      </p>
    </div>
  </section>

  <section class="nf-section">
    <div class="nf-content">
      <a class="nf-link" href="/contact/">Back to the form</a>
    </div>
  </section>
</Base>
