---
import Base from "../layouts/Base.astro";
---
<Base title="Privacy" description="What happens to the information you send through this site.">
  <section class="nf-section">
    <div class="nf-content">
      <h1>The contact form</h1>
      <p>
        The contact form is the one place on this site where you send us information.
        What you type there is delivered to no.fail as an email and is stored nowhere
        else: no database, no queue, no file. The submission exists as that email and
        nothing more. The form sets no cookies.
      </p>
    </div>
  </section>

  <section class="nf-section">
    <div class="nf-content">
      <h2>Privacy policy</h2>
    </div>
  </section>
</Base>
